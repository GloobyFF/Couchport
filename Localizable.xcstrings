    },
    "The PSN account ID must be 8 bytes encoded as base64 (12 characters ending in '=').": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PSN-Konto-ID muss aus 8 Byte im Base64-Format bestehen (12 Zeichen, endet auf '=')."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID de cuenta de PSN debe tener 8 bytes codificados en base64 (12 caracteres que terminan en '=')."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ID de compte PSN doit faire 8 octets encodés en base64 (12 caractères se terminant par '=')."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PSNアカウントIDは、8バイトをbase64でエンコードした値（末尾が'='の12文字）である必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PSN 계정 ID는 base64로 인코딩된 8바이트(12자, '='로 끝남)여야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PSN 账号 ID 必须是 8 字节的 base64 编码（12 个字符，以“=”结尾）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PSN 帳號 ID 必須是 8 位元組的 base64 編碼（12 個字元，以「=」結尾）。"
          }
        }
      }
    },

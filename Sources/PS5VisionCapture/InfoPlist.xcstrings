      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Couchport verwendet den Kamerazugriff, um das Video deiner USB-Capture-Karte anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Used to display video from a connected HDMI UVC capture device."

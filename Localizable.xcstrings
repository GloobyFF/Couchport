    "No UVC capture device found. Check Developer Strap, USB-C cable, capture card power, and PS5 HDCP.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein UVC-Capture-Gerät gefunden. Prüfe Developer Strap, USB-C-Kabel, Stromversorgung der Capture-Karte und HDCP auf der PS5."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ningún dispositivo de captura UVC. Comprueba el Developer Strap, el cable USB-C, la alimentación de la capturadora y el HDCP de la PS5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun périphérique d’acquisition UVC trouvé. Vérifiez le Developer Strap, le câble USB-C, l’alimentation de la carte d’acquisition et le HDCP de la PS5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UVCキャプチャーデバイスが見つかりません。Developer Strap、USB-Cケーブル、キャプチャーカードの電源、PS5のHDCP設定を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UVC 캡처 기기를 찾을 수 없습니다. Developer Strap, USB-C 케이블, 캡처 카드 전원 및 PS5 HDCP 설정을 확인하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 UVC 采集设备。请检查开发者头带、USB‑C 线、采集卡供电以及 PS5 的 HDCP 设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 UVC 擷取裝置。請檢查開發者頭帶、USB‑C 線、擷取卡供電以及 PS5 的 HDCP 設定。"
          }
        }
      }
    },

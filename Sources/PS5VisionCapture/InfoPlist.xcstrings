    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Couchport sucht deine PlayStation im lokalen Netzwerk und verbindet sich für Remote Play mit ihr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Used to find, pair with and stream from your PlayStation on this network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Couchport busca tu PlayStation en la red local y se conecta a ella para usar Remote Play."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Couchport recherche votre PlayStation sur le réseau local et s’y connecte pour Remote Play."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Couchportはリモートプレイのために、ローカルネットワーク上のPlayStationを検出して接続します。"

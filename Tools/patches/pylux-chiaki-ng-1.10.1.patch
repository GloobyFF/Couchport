 // SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+// Couchport: chiaki-ng v1.10.1 feedback sender merged with Pylux's PS chord.
 
 #include <chiaki/feedbacksender.h>

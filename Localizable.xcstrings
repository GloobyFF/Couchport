    "Best with the PS5 on Ethernet and this device on 5 GHz or 6 GHz Wi-Fi.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议 PS5 使用有线网络，本设备连接 5 GHz 或 6 GHz Wi‑Fi。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議 PS5 使用有線網路，本裝置連接 5 GHz 或 6 GHz Wi‑Fi。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am besten mit der PS5 per Ethernet und diesem Gerät im 5‑GHz- oder 6‑GHz-WLAN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona mejor con la PS5 por Ethernet y este dispositivo en Wi‑Fi de 5 GHz o 6 GHz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal avec la PS5 en Ethernet et cet appareil en Wi‑Fi 5 GHz ou 6 GHz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 は有線 LAN、このデバイスは 5 GHz または 6 GHz の Wi‑Fi での利用がおすすめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5는 유선, 이 기기는 5GHz 또는 6GHz Wi‑Fi에 연결하는 것이 좋습니다."
          }
        }

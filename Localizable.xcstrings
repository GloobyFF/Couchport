            "value": "HDR (10 bits)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR（10 ビット）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR(10비트)"
          }
        },
        "zh-Hans": {

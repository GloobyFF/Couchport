    "Connect a 4K60 UVC HDMI capture card through the Developer Strap.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe eine 4K60-UVC-HDMI-Capture-Karte über den Developer Strap an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una capturadora HDMI UVC 4K60 a través del Developer Strap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez une carte d’acquisition HDMI UVC 4K60 via le Developer Strap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Strap経由で4K60対応のUVC HDMIキャプチャーカードを接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Strap을 통해 4K60 UVC HDMI 캡처 카드를 연결하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请通过开发者头带连接 4K60 UVC HDMI 采集卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請透過開發者頭帶連接 4K60 UVC HDMI 擷取卡。"
          }
        }
      }
    },
    "Connect any HDMI device: PlayStation, Xbox, Switch, PC or camera, through a UVC capture card. Wired, lowest latency, up to 4K60.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe jedes HDMI-Gerät über eine UVC-Capture-Karte an: PlayStation, Xbox, Switch, PC oder Kamera. Kabelgebunden, minimale Latenz, bis zu 4K60."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta cualquier dispositivo HDMI (PlayStation, Xbox, Switch, PC o cámara) mediante una capturadora UVC. Con cable, latencia mínima y hasta 4K60."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez n’importe quel appareil HDMI (PlayStation, Xbox, Switch, PC ou caméra) via une carte d’acquisition UVC. Filaire, latence minimale, jusqu’à 4K60."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation、Xbox、Switch、PC、カメラなど、あらゆるHDMI機器をUVCキャプチャーカード経由で接続できます。有線で低遅延、最大4K60。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation, Xbox, Switch, PC, 카메라 등 모든 HDMI 기기를 UVC 캡처 카드로 연결하십시오. 유선, 최저 지연, 최대 4K60."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 UVC 采集卡连接任何 HDMI 设备：PlayStation、Xbox、Switch、电脑或相机。有线连接，延迟最低，最高 4K60。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 UVC 擷取卡連接任何 HDMI 裝置：PlayStation、Xbox、Switch、電腦或相機。有線連接，延遲最低，最高 4K60。"
          }
        }
      }
    },

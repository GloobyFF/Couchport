    "%@ did not wake up. Enable \"Stay Connected to the Internet\" and \"Enable Turning On PS5 from Network\" in the console's power-saving settings.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nicht aktiviert. Aktiviere in den Energiespareinstellungen der Konsole „Mit dem Internet verbunden bleiben“ und „Einschalten der PS5 über das Netzwerk aktivieren“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se ha activado. Activa «Permanecer conectado a Internet» y «Habilitar el encendido de la PS5 desde la red» en los ajustes de ahorro de energía de la consola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne s’est pas réveillée. Activez « Rester connecté à Internet » et « Autoriser la mise sous tension de la PS5 depuis le réseau » dans les paramètres d’économie d’énergie de la console."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を起動できませんでした。本体の省電力設定で「インターネットに接続したままにする」と「ネットワーク経由でPS5の電源を入れられるようにする」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 켜지지 않았습니다. 본체의 절전 설정에서 '인터넷에 연결된 상태 유지'와 '네트워크에서 PS5 전원 켜기 활성화'를 켜십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未能唤醒。请在主机的省电设置中开启“保持连接到互联网”和“允许通过网络开启 PS5”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未能喚醒。請在主機的省電設定中開啟「保持連線到網際網路」和「允許透過網路開啟 PS5」。"
          }
        }
      }
    },

    "DualSense haptics, adaptive triggers and the light bar follow the game. The touchpad is sent as touch input. Haptics and HDR apply on the next connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DualSense-Haptik, adaptive Trigger und Lightbar folgen dem Spiel. Das Touchpad wird als Toucheingabe gesendet. Haptik und HDR gelten ab der nächsten Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta háptica del DualSense, los gatillos adaptativos y la barra de luz siguen al juego. El panel táctil se envía como entrada táctil. La háptica y el HDR se aplican en la próxima conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retour haptique de la DualSense, les gâchettes adaptatives et la barre lumineuse suivent le jeu. Le pavé tactile est envoyé comme saisie tactile. L’haptique et le HDR s’appliquent à la prochaine connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DualSense のハプティクス、アダプティブトリガー、ライトバーはゲームに連動します。タッチパッドはタッチ入力として送信されます。ハプティクスと HDR は次回の接続から有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DualSense 햅틱, 적응형 트리거, 라이트 바가 게임에 맞춰 작동합니다. 터치패드는 터치 입력으로 전송됩니다. 햅틱과 HDR은 다음 연결부터 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DualSense 触觉反馈、自适应扳机和灯条会跟随游戏变化，触控板作为触摸输入发送。触觉反馈和 HDR 在下次连接时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DualSense 觸覺回饋、自適應扳機和燈條會跟隨遊戲變化，觸控板作為觸控輸入傳送。觸覺回饋和 HDR 在下次連線時生效。"
          }
        }
      }
    },
    "Enhance": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildqualität"
          }
        },
        "es": {
          "stringUnit": {

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud key-value storage: the paired-console list (no secrets) is
	     shared between the user's devices, so Apple TV gets consoles paired
	     on iPhone, iPad or Vision Pro. Same identifier on every platform
	     (one bundle ID). Xcode's automatic signing adds the iCloud capability
	     to the App ID. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Add when Apple grants it (see Multicast.entitlements):
	<key>com.apple.developer.networking.multicast</key>
	<true/>
	-->
</dict>
</plist>

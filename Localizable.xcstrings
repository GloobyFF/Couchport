    "Formats reported by the selected capture card. Some cards may scale the HDMI input internally.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der ausgewählten Capture-Karte gemeldete Formate. Einige Karten können den HDMI-Eingang intern skalieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatos indicados por la tarjeta de captura seleccionada. Algunas tarjetas pueden escalar internamente la entrada HDMI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formats signalés par la carte de capture sélectionnée. Certaines cartes peuvent redimensionner l’entrée HDMI en interne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したキャプチャカードが報告するフォーマットです。一部のカードはHDMI入力を内部で拡大・縮小します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 캡처 카드가 보고한 포맷입니다. 일부 카드는 HDMI 입력을 내부적으로 조정할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些格式由所选采集卡报告。部分采集卡可能会在内部缩放 HDMI 输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些格式由所選擷取卡回報。部分擷取卡可能會在內部縮放 HDMI 輸入。"
          }
        }
      }
    },

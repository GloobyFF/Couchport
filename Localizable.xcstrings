          "stringUnit": {
            "state": "translated",
            "value": "Vorschau läuft. Ist das Bild schwarz, deaktiviere HDCP/HDR/120Hz/VRR an der Quelle und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa está activa. Si la imagen es negra, desactiva HDCP/HDR/120Hz/VRR en la fuente y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu en cours. Si l’image est noire, désactivez HDCP/HDR/120Hz/VRR sur la source et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー中です。映像が真っ暗な場合は、入力元のHDCP/HDR/120Hz/VRRをオフにして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기 실행 중입니다. 화면이 검은색이면 소스의 HDCP/HDR/120Hz/VRR을 끄고 다시 시도하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览运行中。如果画面全黑，请关闭信号源的 HDCP/HDR/120Hz/VRR 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽執行中。如果畫面全黑，請關閉訊號源的 HDCP/HDR/120Hz/VRR 後重試。"
          }
        }
      }
    },

    "A one-time purchase. Family Sharing and restore work with the same Apple Account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买。使用同一 Apple 账户即可恢复购买并通过家人共享使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性購買。使用同一 Apple 帳號即可回復購買並透過家人共享使用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger Kauf. Familienfreigabe und Wiederherstellen funktionieren mit demselben Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. En Compartir en familia y al restaurar se usa la misma cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat unique. Le partage familial et la restauration fonctionnent avec le même compte Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りです。同じ Apple アカウントで復元とファミリー共有ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 구매하면 됩니다. 같은 Apple 계정으로 복원 및 가족 공유가 가능합니다."
          }
        }
      }
    },
